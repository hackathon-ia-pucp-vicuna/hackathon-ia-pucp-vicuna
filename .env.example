# Copia este archivo como .env y completa los valores. .env está en .gitignore: nunca se sube al repo.
# app/notify/telegram.py carga .env solo (sin pisar variables ya definidas; T18, #37). Para cargarlo a mano:
#   bash: set -a; . ./.env; set +a   ·   PowerShell: Get-Content .env | ? { $_ -match "^[A-Z_]+=" } | % { $k, $v = $_ -split "=", 2; Set-Item "env:$k" $v }
# En GitHub Actions (T48) estos valores van como secretos del repositorio, no en archivos.

# Telegram (T18, T38): token del bot que da @BotFather y canal donde el bot es administrador.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@nombre_del_canal

# Opcional: ruta de la caché del pronóstico de Open-Meteo (por defecto app/gfs_cache.npz). La usa la app (T17).
# HELADA_CACHE_GFS=app/gfs_cache.npz

# Reservadas: las usarán T19 (#38, confirmaciones) y T37 (#39, log de errores de Telegram) cuando entren.
# HELADA_DB=app/confirmaciones.sqlite
# HELADA_LOG_TELEGRAM=app/notify/telegram_errores.log
